name: build

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: auto-clicker-mod
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.10.2
          build-root-directory: auto-clicker-mod

      - name: Build
        run: gradle clean build --stacktrace

      - name: Enviar o jar
        uses: actions/upload-artifact@v4
        with:
          name: auto-clicker-mod
          path: auto-clicker-mod/build/libs/*.jar
          if-no-files-found: error
